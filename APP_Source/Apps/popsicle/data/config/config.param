<sessions>
	<popsicle%>
		extends_base=<sessions.base%>
		node_action=<wm_postsetup>
	</popsicle%>
  <popsicle0>
		<name_localized>
			displayname[en_us]=<Popsicle>
		</name_localized>
		<icon>
            value=</services/popsicle/.icons/app.svg>
		</icon>
		<type>
			displayname[en_us]=<Misc>
		</type>
  </popsicle0>
</sessions>