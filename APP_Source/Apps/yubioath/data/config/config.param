<sessions>
	<yubioath%>
		extends_base=<sessions.base%>
		node_action=<wm_postsetup>
	</yubioath%>
  <yubioath0>
		<name_localized>
			displayname[en_us]=<Yubico Authenticator>
		</name_localized>
		<icon>
            value=</services/yubioath/.icons/app.png>
		</icon>
		<type>
			displayname[en_us]=<Misc>
		</type>
  </yubioath0>
</sessions>