<sessions>
	<signal%>
		extends_base=<sessions.base%>
		node_action=<wm_postsetup>
	</signal%>
  <signal0>
		<name_localized>
			displayname[en_us]=<Signal>
		</name_localized>
		<icon>
            value=</services/signal/.icons/app.svg>
		</icon>
		<type>
			displayname[en_us]=<Misc>
		</type>
  </signal0>
</sessions>