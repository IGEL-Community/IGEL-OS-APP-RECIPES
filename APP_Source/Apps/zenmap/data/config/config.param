<sessions>
	<zenmap%>
		extends_base=<sessions.base%>
		node_action=<wm_postsetup>
	</zenmap%>
  <zenmap0>
		<name_localized>
			displayname[en_us]=<Zenmap>
		</name_localized>
		<icon>
            value=</services/zenmap/.icons/app.svg>
		</icon>
		<type>
			displayname[en_us]=<Misc>
		</type>
  </zenmap0>
</sessions>