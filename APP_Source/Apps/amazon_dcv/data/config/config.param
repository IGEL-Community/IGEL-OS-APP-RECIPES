<sessions>
	<amazondcv%>
		extends_base=<sessions.base%>
		node_action=<wm_postsetup>
	</amazondcv%>
	<amazondcv0>
		<name_localized>
			displayname[en_us]=<Amazon DCV Client>
		</name_localized>
		<icon>
			value=</services/amazondcv/.icons/app.svg>
		</icon>
		<type>
			displayname[en_us]=<Misc>
		</type>
	</amazondcv0>
</sessions>
<config>
	<connection_server>
		value=<>
		type=<sting>
		runtime=<true>
		displayname[en_us]=<Connection Server>
		tooltip[en_us]=<Connection Server>
	</connection_server>
</config>
<config_schema_version>
	value=<1>
	type=<integer>
	runtime=<false>
</config_schema_version>
