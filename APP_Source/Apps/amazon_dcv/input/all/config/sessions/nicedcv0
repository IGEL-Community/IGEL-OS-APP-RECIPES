#!/bin/sh
# Amazon DCV Viewer launcher for IGEL OS custom app mount point.
# Restart v2: stable runtime baseline plus session-level server field.
# Keeps POSIX /bin/sh compatibility, DCV private library path, and GDK Pixbuf/SVG loader environment.

APPNAME="amazondcv"
DCVROOT="/services/amazondcv"
basedir="${DCVROOT}/usr"
variant="dcvviewer"
libdir="${basedir}/lib/x86_64-linux-gnu"
dcvlib="${libdir}/${variant}"
datadir="${basedir}/share"
dcvviewer_bin="${dcvlib}/dcvviewer"
logfile="/tmp/amazondcv-launch.log"

# Private libraries from the upstream .deb, including libdcv.so.
LD_LIBRARY_PATH="${dcvlib}:${libdir}:${dcvlib}/cef:${LD_LIBRARY_PATH:-}"
export LD_LIBRARY_PATH

PATH="${basedir}/bin:${dcvlib}:${PATH:-}"
export PATH

# Data/schema/module paths expected by the upstream Ubuntu package.
XDG_DATA_DIRS="${datadir}:/usr/share:/usr/local/share:${XDG_DATA_DIRS:-}"
export XDG_DATA_DIRS

GIO_EXTRA_MODULES="${dcvlib}/gio/modules"
GST_PLUGIN_SCANNER="${dcvlib}/gst-plugin-scanner"
GST_PLUGIN_SYSTEM_PATH="${dcvlib}/gstreamer-1.0"
GTK_PATH="${dcvlib}"
PANGO_LIBDIR="${dcvlib}"
GSETTINGS_SCHEMA_DIR="${datadir}/${variant}/schemas"
FONTCONFIG_PATH="/etc/fonts"
DCV_SASL_PLUGIN_DIR="${dcvlib}/sasl2"
export GIO_EXTRA_MODULES GST_PLUGIN_SCANNER GST_PLUGIN_SYSTEM_PATH GTK_PATH PANGO_LIBDIR GSETTINGS_SCHEMA_DIR FONTCONFIG_PATH DCV_SASL_PLUGIN_DIR

# Prefer the app-local GDK Pixbuf loader cache when present.
if [ -f "${dcvlib}/gdk-pixbuf-2.0/2.10.0/loaders.cache" ]; then
    GDK_PIXBUF_MODULEDIR="${dcvlib}/gdk-pixbuf-2.0/2.10.0/loaders"
    GDK_PIXBUF_MODULE_FILE="${dcvlib}/gdk-pixbuf-2.0/2.10.0/loaders.cache"
    export GDK_PIXBUF_MODULEDIR GDK_PIXBUF_MODULE_FILE
fi

# Simple logging for field validation. This should not block launch.
{
    echo "---- $(date) amazondcv launcher restart-v2 ----"
    echo "LD_LIBRARY_PATH=${LD_LIBRARY_PATH}"
    echo "GDK_PIXBUF_MODULEDIR=${GDK_PIXBUF_MODULEDIR:-}"
    echo "GDK_PIXBUF_MODULE_FILE=${GDK_PIXBUF_MODULE_FILE:-}"
    echo "DCV binary=${dcvviewer_bin}"
} >> "${logfile}" 2>/dev/null || true

# Try to read a session URL/server from IGEL setup registry if a helper exists.
read_param() {
    key="$1"
    #if command -v get_param >/dev/null 2>&1; then
        #get_param "$key" 2>/dev/null || true
        #return
    #fi
    if [ -x /bin/get ]; then
        /bin/get "$key" 2>/dev/null || true
        return
    fi
    #if [ -x /sbin/get_param ]; then
        #/sbin/get_param "$key" 2>/dev/null || true
        #return
    #fi
    #if command -v igel_config >/dev/null 2>&1; then
        #igel_config "$key" 2>/dev/null || true
        #return
    #fi
    return 0
}

server=""
for key in \
    "app.amazondcv.config.connection_server"
do
    value="$(read_param "$key" | tail -n 1 | sed -e 's/^value=//' -e 's/[<>]//g' | tr -d '\r')"
    if [ -n "$value" ] && [ "$value" != "null" ]; then
        server="$value"
        echo "Using server from ${key}: ${server}" >> "${logfile}" 2>/dev/null || true
        break
    fi
done

if [ ! -x "${dcvviewer_bin}" ]; then
    echo "ERROR: DCV binary not executable or missing: ${dcvviewer_bin}" >> "${logfile}" 2>/dev/null || true
    exit 127
fi

# Launch. A plain hostname is converted to dcv://hostname.
if [ -n "${server}" ]; then
    case "${server}" in
        dcv://*|http://*|https://*)
            exec "${dcvviewer_bin}" "${server}" "$@"
            ;;
        *)
            exec "${dcvviewer_bin}" "dcv://${server}" "$@"
            ;;
    esac
else
    exec "${dcvviewer_bin}" "$@"
fi
