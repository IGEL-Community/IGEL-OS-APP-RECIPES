			displayname[en_us]=<RealVNC Connect Viewer>
		</name_localized>
		<icon>
            value=</services/realvnc_client/.icons/app.svg>
		</icon>
		<type>
			displayname[en_us]=<Misc>
		</type>
  </realvnc_client0>
</sessions>