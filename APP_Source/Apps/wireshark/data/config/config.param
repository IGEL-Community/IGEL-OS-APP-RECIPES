<sessions>
	<wireshark%>
		extends_base=<sessions.base%>
		node_action=<wm_postsetup>
	</wireshark%>
  <wireshark0>
		<name_localized>
			displayname[en_us]=<Wireshark>
		</name_localized>
		<icon>
            value=</services/wireshark/.icons/app.svg>
		</icon>
		<type>
			displayname[en_us]=<Misc>
		</type>
  </wireshark0>
</sessions>