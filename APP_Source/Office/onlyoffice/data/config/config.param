<sessions>
	<onlyoffice%>
		extends_base=<sessions.base%>
		node_action=<wm_postsetup>
	</onlyoffice%>
  <onlyoffice0>
		<name_localized>
			displayname[en_us]=<ONLYOFFICE Desktop Editors>
		</name_localized>
		<icon>
            value=</services/onlyoffice/.icons/app.svg>
		</icon>
		<type>
			displayname[en_us]=<Misc>
		</type>
  </onlyoffice0>
</sessions>